# TAROTCHAT_GROQ_API_KEY=
# TAROTCHAT_GROQ_MODEL=
# Stripe keys are used by your existing checkout backend / Vercel integration
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
